# Settings for local development. Copy this file to .dev.vars, which is
# git-ignored and never deployed. `pnpm dev` reads it.

# Signs you in without Cloudflare Access. Works on localhost only.
AUTH_MODE=dev

# Who you are signed in as. The first person through becomes the owner.
DEV_MEMBER_EMAIL=cook@example.com

# Importing with AI, without Cloudflare: a scripted stand-in reads pasted text
# by a few simple rules. Works on localhost only. Remove the line and run
# `pnpm exec wrangler dev`, signed in, to use real models, which are billed.
AI_MODE=stand-in
