{
  "name": "recipeflare",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:.*/\"",
    "dev:worker": "node scripts/ensure-web-dist.mjs && wrangler dev",
    "dev:web": "pnpm --filter @recipeflare/web dev",
    "build": "pnpm --filter @recipeflare/web build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "types": "wrangler types apps/worker/worker-configuration.d.ts",
    "typecheck": "pnpm run types && pnpm -r run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  }
}
