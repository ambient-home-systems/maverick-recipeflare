// Worker configuration for Recipeflare.
// This file sits at the repository root because the Deploy to Cloudflare button
// reads the Wrangler file of the directory it clones.
// It must never contain hostnames, account IDs or resource IDs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipeflare",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-11-22",
  // Declared so that tests and production run with the same flags.
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "apps/web/dist",
    "not_found_handling": "single-page-application",
    // The API always runs the Worker, even for browser navigations such as
    // opening an image or attachment in a new tab.
    "run_worker_first": ["/api/*"]
  },

  // Resources are named, never identified by ID. Wrangler creates each one on
  // the first deploy and finds it by name afterwards.
  //
  // Migrations are one folder each, as Drizzle writes them. Wrangler records a
  // migration by its path under migrations_dir, so a folder is never renamed.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recipeflare",
      "migrations_dir": "apps/worker/migrations",
      "migrations_pattern": "apps/worker/migrations/*/migration.sql"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "recipeflare-media" }],
  // Resizes an uploaded photo into the two sizes the app shows. It names no
  // resource. If a resize fails the original photo is served instead.
  "images": { "binding": "IMAGES" },
  // Workers AI, for reading recipe cards and pages. It names no resource. It
  // has no local version: `pnpm dev`, the tests and the end-to-end run all
  // leave it out, and only apps/worker/src/ai/ may use it.
  "ai": { "binding": "AI" },
  // Imports are jobs on one queue, consumed by this same Worker. Each message
  // is a job's ID. A message that has failed three retries goes to the
  // dead-letter queue, whose consumer, also this Worker, marks the job failed,
  // so nothing is lost silently. A batch is not waited for: an import starts at once.
  // A message is one stage of one import, and a stage can be a model call that
  // takes minutes. The jobs of a batch run side by side, so a batch takes as
  // long as its slowest job; four to a batch keeps their photos inside memory.
  "queues": {
    "producers": [{ "binding": "IMPORT_QUEUE", "queue": "recipeflare-imports" }],
    "consumers": [
      {
        "queue": "recipeflare-imports",
        "max_batch_size": 4,
        "max_batch_timeout": 0,
        "max_retries": 3,
        "dead_letter_queue": "recipeflare-imports-dlq"
      },
      { "queue": "recipeflare-imports-dlq", "max_batch_size": 10, "max_batch_timeout": 0 }
    ]
  },

  // The top-level configuration is production, for this install and for every
  // install made with the Deploy to Cloudflare button. It sets no route: a
  // custom domain is passed at deploy time (see scripts/deploy.mjs), and
  // without one the Worker is served on workers.dev.
  //
  // Staging is this project's own second copy. Bindings are not inherited by
  // environments, so they are repeated here with staging names.
  "env": {
    "staging": {
      // Staging is only ever reached through its custom domain.
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "recipeflare-staging",
          "migrations_dir": "apps/worker/migrations",
          "migrations_pattern": "apps/worker/migrations/*/migration.sql"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "recipeflare-staging-media" }],
      "images": { "binding": "IMAGES" },
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [{ "binding": "IMPORT_QUEUE", "queue": "recipeflare-staging-imports" }],
        "consumers": [
          {
            "queue": "recipeflare-staging-imports",
            "max_batch_size": 4,
            "max_batch_timeout": 0,
            "max_retries": 3,
            "dead_letter_queue": "recipeflare-staging-imports-dlq"
          },
          {
            "queue": "recipeflare-staging-imports-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 0
          }
        ]
      }
    }
  }
}
